# For a manual (non-Docker) backend run against the Dockerized Postgres, point
# this at localhost:${POSTGRES_HOST_PORT}. Leave it at 5432 only if you are
# sure nothing else (a native Postgres install) is already listening there.
DATABASE_URL=postgresql+asyncpg://cpaf_user:cpaf_pass@localhost:5432/cpaf_db
REDIS_URL=redis://localhost:6379
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_DB=cpaf_db
POSTGRES_USER=cpaf_user
POSTGRES_PASSWORD=cpaf_pass
# Host-side port for the postgres container (docker-compose.yml). Defaults to
# 5433 to avoid clashing with a native Postgres already bound to 5432.
POSTGRES_HOST_PORT=5433
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
GEOCODING_TIMEOUT=5
MODEL_VERSION=1.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
ANTHROPIC_API_KEY=
