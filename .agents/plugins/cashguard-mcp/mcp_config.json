{
  "mcpServers": {
    "cashguard-mcp": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--add-host=host.docker.internal:host-gateway",
        "-e",
        "DATABASE_URL=postgresql://cpaf_user:cpaf_pass@host.docker.internal:5432/cpaf_db",
        "-e",
        "REDIS_URL=redis://host.docker.internal:6379",
        "cashguard-mcp:latest"
      ]
    }
  }
}
